generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())

  username     String   @unique
  passwordHash String

  name         String

  role         AdminRole @default(ADMIN)

  isActive     Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]

  @@index([username])
}

model Session {
  id         String   @id @default(cuid())

  token      String   @unique

  adminId    String
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  expiresAt  DateTime

  lastUsedAt DateTime @default(now())

  @@index([token])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Alumni {
  id         String        @id @default(cuid())
  name       String
  batch      String
  college    String
  company    String
  city       String
  status     AlumniStatus  @default(ACTIVE)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum AlumniStatus {
  ACTIVE
  HIDDEN
}

model Event {

  id          String @id @default(cuid())

  title       String
  description String

  category    String

  venue       String

  date        String
  time        String

  banner      String

  featured    Boolean @default(false)

  status      EventStatus @default(UPCOMING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}
model Announcement {
  id          String             @id @default(cuid())
  title       String
  description String
  category    String
  publishDate String
  expiryDate  String
  pinned      Boolean            @default(false)
  status      AnnouncementStatus @default(DRAFT)
  createdBy   String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, publishDate])
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model GalleryFolder {
  id          String         @id @default(cuid())
  eventName   String
  eventDate   String
  description String
  coverImage  String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  photos      GalleryPhoto[]

  @@index([eventDate])
}

model GalleryPhoto {
  id        String        @id @default(cuid())
  url       String
  createdAt DateTime      @default(now())
  folderId  String
  folder    GalleryFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}
